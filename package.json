{
  "name": "dotcloser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "app.js",
  "description": "DotCloser — domain sales outreach workspace",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app.js",
    "dev": "node --watch --env-file-if-exists=.env app.js",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "nodemailer": "10.0.11",
    "stripe": "22.6.2"
  }
}
