NODE_ENV=production
PORT=3000
APP_URL=https://dotcloser.com
DATABASE_PATH=./data/dotcloser.sqlite
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SESSION_SECRET=
# Google login AND Gmail connection use /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook login uses /auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v25.0
# Outlook mailbox connection uses /auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# External data services are only enabled after you confirm reuse rights.
REGCOUNT_API_URL=https://regcount.com
REGCOUNT_ENABLED=false
DOTDB_API_KEY=
DOTDB_ENABLED=false
# Optional licensed business-contact enrichment. Only public role contacts are selected.
HUNTER_API_KEY=
# Set a valid seller business address in each user's Profile before sending.
TRIAL_DAYS=7
TRIAL_SEND_LIMIT=10
STANDARD_DAILY_SEND_LIMIT=50
SEND_INTERVAL_SECONDS=60
# Optional local-only preview; never enables authentication or real sending.
DEMO_ENABLED=true
